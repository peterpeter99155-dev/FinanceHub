{
  "name": "financehub",
  "productName": "FinanceHub",
  "version": "0.1.0",
  "description": "A local-first personal finance dashboard centered on net worth.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:build": "webpack --config tests/e2e/webpack.config.cjs",
    "test:e2e": "npm run test:e2e:build && playwright test",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "test:package-smoke": "npm run package && node tests/smoke/package-smoke.cjs",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "author": "FinanceHub",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.62.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "css-loader": "7.1.2",
    "electron": "42.7.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "node-loader": "2.1.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "webpack": "5.104.1",
    "webpack-cli": "6.0.1"
  }
}
